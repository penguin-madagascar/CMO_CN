  "translations": [
    {"id": "PH9-427230-Cabugao", "zh": "卡布高", "status": "approved", "source": "@source/caa343f96cc7ae0c", "record_sha256": "453de95c8542924f1efa47567d9c06f12ea05869fe327fa6dd48765a9bf1d332", "review_notes": "南伊罗戈省卡布高。当地政府资料确定同地，国家教育研究院辞书明确并列卡布高与 Cabugao。"},
    {"id": "PH9-427230-San-Juan", "zh": "圣胡安", "status": "approved", "source": "@source/a3d23abc1e864dd9", "record_sha256": "c49d26359865060b3e77155c8b6309888cc7eecac93bca0db387ca854814c6e5", "review_notes": "中心约北纬17.6833东经120.7301，对应阿布拉省圣胡安市镇，按西班牙语地名通行译法。"},
    {"id": "PH9-427230-Vigan", "zh": "美岸", "status": "approved", "source": "@source/de57b59c289acedb", "record_sha256": "429ddc5291da7a077e4bf496a2f3824f8ece416188b145b32bd3b1b28550fb9e", "review_notes": "沿用正式汉化 z7 AP-S7-159 与 z8 AP-SC8-002 的同一译名。"},
    {"id": "PH9-427230-Bangued", "zh": "邦贵", "status": "approved", "source": "@source/be09d3bd5effefee", "record_sha256": "473f2f20945cea689794dc44bbfa5e0fbe254f5e39ad235d89cd4fd6fc7cd77e", "review_notes": "菲律宾统计管理局确认阿布拉省同一首府。中文实地报道明确并列邦贵与 Bangued。"},
    {"id": "PH9-427230-Bucay", "zh": "布凯", "status": "approved", "source": "@source/572117ec9bbcb250", "record_sha256": "7739a89411de226319e04e2a59b593903922d385cc1b1578debfd9d443747f75", "review_notes": "菲律宾统计管理局确认阿布拉省同一市镇，译名按当地读音音译为布凯。"}
