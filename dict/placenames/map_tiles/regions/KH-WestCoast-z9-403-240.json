  "translations": [
    {"id": "KH-WestCoast-z9-403-240-sre-ambel", "zh": "盐田", "source": "@source/6991efdbd76094d6", "status": "approved", "record_sha256": "5bd52fda8814c70dddac60af2f9109e05967ba4fe07b03ccf31f2d8a5b582c88", "review_notes": "Official gazetteer identifies Srae Ambel district 0906. Local bilingual usage pairs 盐田县 with Srae Ambel, and an original Sino-Cambodian project uses variant 斯雷温贝. The Source town label lacks a suffix."},
    {"id": "KH-WestCoast-z9-403-240-kampong-seila", "zh": "甘榜塞拉", "source": "@source/3f58d3fb57f90fcb", "status": "approved", "record_sha256": "ee9616e7b21b3ca412d47787251540547ada8cec8a647754df5960f5168ef587", "review_notes": "Government planning paragraph pairs 甘榜塞拉镇中心 and Kampong Seila town center across its Chinese and English editions. The Source wraps one name onto two lines."},
    {"id": "KH-WestCoast-z9-403-240-prey-nob", "zh": "普雷诺", "source": "@source/3f58d3fb57f90fcb", "status": "approved", "record_sha256": "5966d382626aaeae96be8b4c49f1a7e5913f13e18c23bb81877358e0f1d72cf3", "review_notes": "Cambodian government Chinese planning uses 普雷诺 repeatedly and also has a 波罗诺 variant. The actual site occupant lists the same address as Prey Nob and 普雷诺县 in its bilingual catalogue."},
    {"id": "KH-WestCoast-z9-403-240-sihanoukville", "zh": "西哈努克市", "source": "@source/e1861108549269df", "status": "approved", "record_sha256": "3bd453648f294d7476080914f3eaeebcdfcb87f54ebf5fcde9b491c685c6e2d9", "review_notes": "The Chinese commerce guide uses the exact bilingual name. Keep the identical Chinese name already visible here from the Cities.wwp fallback."}
